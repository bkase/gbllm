    "rng": "XorShift16 (planv0 RngSpec::XorShift16), shift triple (7,9,8), full period 65535, seed 0 canonicalized to 1, one draw per token",
    "rng_shifts": [
      7,
      9,
      8
    ],
    "exp_lut": "256 x u8, lut[u] = round_ties_even(255 * 2^(-u/16)); zero for u >= 144",
    "exp_lut_alpha": 16,
    "exp_lut_sha256": "ea328cd5a436b04eb1f97a829eec3931dd2cb01a03c35bdf412279c860bc4678",
    "lut_index_rule": "u = min(255, (d * scale_q16 + 0x8000) >> 16), d = max_logit - logit in raw i24 logit units (round-half-up Q16 multiply)",
    "threshold_rule": "threshold = (r * total_weight) >> 16 (truncating); pick the first candidate in selection order whose cumulative weight strictly exceeds it",
    "selection_rule": "top-k by k partial scans; pass 0 is the deployed argmax rule; later passes skip used ids; ties go to the lower id",
    "temperature_rule": "scale_q16 = round_ties_even(65536 * 16 * logit_step / (T * ln 2)) folded at build time",
    "logit_dequant_step": 0.00632128565330205
  },
